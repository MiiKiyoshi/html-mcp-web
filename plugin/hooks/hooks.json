{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guide_gate.py\" session-start"}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__html-mcp__guide",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guide_gate.py\" guide-read"}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guide_gate.py\" before-edit"}
        ]
      }
    ]
  }
}
